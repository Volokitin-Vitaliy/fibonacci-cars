# --- Main ---
DOMAIN=your-domain.com
SITE_URL=https://your-domain.com
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Secret address of the admin instead of /admin/ (letters, digits, dashes), e.g. office-7f3k2q
ADMIN_URL=change-me-secret-admin

# --- Database ---
POSTGRES_DB=fibonacci
POSTGRES_USER=fibonacci
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Email ---
DEFAULT_FROM_EMAIL=FIBONACCI <no-reply@your-domain.com>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
MODERATION_EMAILS=fibonacci.iox@gmail.com

# --- Listings ---
LISTING_DURATION_DAYS=30
LISTING_REMINDER_DAYS=3
LISTING_MODERATION=True
LISTING_PRICE_EUR=10.00
LISTING_PAYMENT_REQUIRED=False
USD_TO_EUR_RATE=0.92

# --- WayForPay ---
PAYMENT_PROVIDER=wayforpay
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=
WAYFORPAY_DOMAIN=your-domain.com
WAYFORPAY_CURRENCY=EUR

# --- Sign in with Google / Apple (leave empty to hide the buttons) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Hollmann import ---
HOLLMANN_IMPORT_MEDIA=True
HOLLMANN_MAX_PHOTOS=20

# --- Bot protection on sign-up and the listing form (Cloudflare Turnstile) ---
# Free keys: Cloudflare dashboard -> Turnstile -> Add site. Leave empty to switch off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Error reports (optional, free plan at sentry.io) ---
SENTRY_DSN=

# --- Content-Security-Policy: on by default. CSP_REPORT_ONLY=True only reports problems ---
CSP_ENABLED=True
CSP_REPORT_ONLY=False

# --- Moderation in Telegram (see README): token from @BotFather, chat ids from /start ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_IDS=

# --- Automatic translation of descriptions RU <-> EN (see README): DeepL API key ---
DEEPL_API_KEY=

# --- Site analytics in the admin (see README) ---
ADMIN_TIME_ZONE=Europe/Berlin
# ANALYTICS_EXCLUDE_STAFF=True
# ANALYTICS_RETENTION_DAYS=800

# --- Cloudflare: yes = answer only requests that come through Cloudflare (see README) ---
CLOUDFLARE_ONLY=no
