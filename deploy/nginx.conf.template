# nginx for FIBONACCI. ${DOMAIN} is filled in from .env when the container starts.
# Docker's internal DNS: the site container gets a new address whenever it is rebuilt,
# so its name is looked up at request time instead of once at nginx start (that caused 502s).
resolver 127.0.0.11 valid=10s ipv6=off;

# --- Cloudflare (see README) ---
# Behind Cloudflare every request arrives from a Cloudflare address; the visitor's own
# address is in CF-Connecting-IP. Trusted only from Cloudflare's ranges
# (https://www.cloudflare.com/ips), so login limits, the admin lockout and analytics
# see the real visitor. Without Cloudflare this changes nothing.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# CLOUDFLARE_ONLY=yes in .env: answer only requests that come through Cloudflare, so the
# server's own IP address cannot be used to go around the protection.
geo $realip_remote_addr $from_cloudflare {
    default 0;
    173.245.48.0/20 1;
    103.21.244.0/22 1;
    103.22.200.0/22 1;
    103.31.4.0/22 1;
    141.101.64.0/18 1;
    108.162.192.0/18 1;
    190.93.240.0/20 1;
    188.114.96.0/20 1;
    197.234.240.0/22 1;
    198.41.128.0/17 1;
    162.158.0.0/15 1;
    104.16.0.0/13 1;
    104.24.0.0/14 1;
    172.64.0.0/13 1;
    131.0.72.0/22 1;
    2400:cb00::/32 1;
    2606:4700::/32 1;
    2803:f800::/32 1;
    2405:b500::/32 1;
    2405:8100::/32 1;
    2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}
map "$from_cloudflare:${CLOUDFLARE_ONLY}" $not_through_cloudflare {
    "0:yes" 1;
    default 0;
}

# At most 10 login / sign-up requests a minute from one address (plus a short burst);
# the app itself also locks an account for 15 minutes after 5 wrong passwords.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};
    if ($not_through_cloudflare) { return 444; }

    # Let's Encrypt renewals
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;
    client_max_body_size 25M;
    if ($not_through_cloudflare) { return 444; }

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Security headers for every response, including photos and static files.
    add_header X-Content-Type-Options nosniff always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json text/plain application/xml;

    # File names carry a content hash, so they can be cached for a year.
    location /static/ {
        alias /app/static/;
        # Never re-checked by the browser: a changed file gets a new name.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /media/ {
        alias /app/media/;
        expires 30d;
    }

    # Login, sign-up and email confirmation pages, on the site and in the admin.
    location ~ /(login|register|verify)/ {
        limit_req zone=auth burst=10 nodelay;
        set $django http://web:8000;
        proxy_pass $django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        set $django http://web:8000;
        proxy_pass $django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
