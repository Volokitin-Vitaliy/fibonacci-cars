# nginx for FIBONACCI. ${DOMAIN} is filled in from .env when the container starts.
upstream django {
    server web:8000;
}

# At most 10 login / sign-up requests a minute from one address (plus a short burst);
# the app itself also locks an account for 15 minutes after 5 wrong passwords.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Let's Encrypt renewals
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};
    server_tokens off;
    client_max_body_size 25M;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Security headers for every response, including photos and static files.
    add_header X-Content-Type-Options nosniff always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json text/plain application/xml;

    # File names carry a content hash, so they can be cached for a year.
    location /static/ {
        alias /app/static/;
        expires 1y;
    }

    location /media/ {
        alias /app/media/;
        expires 30d;
    }

    # Login, sign-up and email confirmation pages, on the site and in the admin.
    location ~ /(login|register|verify)/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
